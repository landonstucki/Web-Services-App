### Get all contacts LocalHost
# This request asks the local server for every contact in the database.
# Method: GET (read data)
GET http://localhost:3000/contacts

### Get Landon contact LocalHost
# This request gets a single contact by its MongoDB _id using a query string.
# Replace the id below with a real one returned from your database.
GET http://localhost:3000/contacts/single?id=69f6a69b874f9b824237b793



### Create contact LocalHost
# This request creates a new contact in the database.
# Method: POST (create data)
POST http://localhost:3000/contacts
Content-Type: application/json

{
	"firstName": "David",
	"lastName": "Blane",
	"email": "David@example.com",
	"favoriteColor": "blue",
	"birthday": "1990-01-01"
}

### Update contact LocalHost (replace with real id)
# This request updates an existing contact by id.
# Method: PUT (replace/update data)
PUT http://localhost:3000/contacts/69ffee8a29e877480d7935b7
Content-Type: application/json

{
	"firstName": "Jane",
	"lastName": "Stucki",
	"email": "newjane@email.com",
	"favoriteColor": "green",
	"birthday": "1990-01-01"
}

### Delete contact LocalHost (replace with real id)
# This request deletes a contact by id.
# Method: DELETE (remove data)
DELETE http://localhost:3000/contacts/69f6a69b874f9b824237b793


### Get all contacts Render
# Same as local GET, but against your deployed Render URL.
GET https://web-services-app.onrender.com/contacts

### Get Landon contact Render
