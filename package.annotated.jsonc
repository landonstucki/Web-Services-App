// Annotated copy of package.json for learning purposes only.
// Note: npm/yarn/pnpm do NOT read comments; keep using package.json to run your app.
{
  // Package name used by npm registries and tooling
  "name": "web-services-app",
  // Semantic version of your application
  "version": "1.0.0",
  // Short human-readable description (optional)
  "description": "",
  // Main entry point for consumers (not used by `npm start` here)
  "main": "index.js",
  // Script commands you can run via `npm run <name>`
  "scripts": {
    // Placeholder test script that always exits with an error
    "test": "echo \"Error: no test specified\" && exit 1",
    // Start the application using Node and server.js
    "start": "node server.js",
  },
  // Optional search keywords for package discovery
  "keywords": [],
  // Package author information (optional)
  "author": "",
  // License identifier for the project
  "license": "ISC",
  // Libraries your app needs at runtime
  "dependencies": {
    // Loads environment variables from a .env file into process.env
    "dotenv": "^17.4.2",
    // Web framework for building HTTP APIs
    "express": "^5.2.1",
    // Official MongoDB driver for Node.js
    "mongodb": "^7.2.0",
  },
}
